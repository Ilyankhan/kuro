FROM python:3.12-slim

# Install system tools: binutils, gcc, libc-dev
RUN apt-get update && apt-get install -y --no-install-recommends \
    binutils \
    gcc \
    libc6-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create isolated, unprivileged runner user
RUN useradd -m -u 1000 -s /bin/bash kuro-runner

WORKDIR /workspace
RUN chown -R kuro-runner:kuro-runner /workspace

USER kuro-runner

CMD ["/bin/bash"]
